        </table>

        <h3>Sync API (Webhooks from Payroll)</h3>
        <table>
            <tr>
                <th>Endpoint</th>
                <th>Method</th>
                <th>Purpose</th>
                <th>Auth</th>
            </tr>
            <tr>
                <td>/api/employees/sync</td>
                <td>POST</td>
                <td>Receive employee updates</td>
                <td>X-API-Token</td>
            </tr>
            <tr>
                <td>/api/departments/sync</td>
                <td>POST</td>
                <td>Receive department updates</td>
                <td>X-API-Token</td>
            </tr>
            <tr>
                <td>/api/users/sync-password</td>
                <td>POST</td>
                <td>Sync password changes</td>
                <td>JWT Token</td>
            </tr>
        </table>

        <h3>Permissions API</h3>
        <table>
            <tr>
                <th>Endpoint</th>
                <th>Method</th>
                <th>Purpose</th>
                <th>Auth</th>
            </tr>
            <tr>
                <td>/api/permissions</td>
                <td>GET</td>
                <td>List all permissions</td>
                <td>Bearer Token</td>
            </tr>
            <tr>
                <td>/api/user-permissions</td>
                <td>POST</td>
                <td>Update user permissions</td>
                <td>Bearer Token (Admin)</td>
            </tr>
        </table>

        ---

