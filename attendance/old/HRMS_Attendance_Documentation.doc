            </tr>
        </table>

        <h3>Attendance API (For Payroll)</h3>
        <table>
            <tr>
                <th>Endpoint</th>
                <th>Method</th>
                <th>Purpose</th>
                <th>Auth</th>
            </tr>
            <tr>
                <td>/api/payroll/attendance-data</td>
                <td>GET</td>
                <td>Fetch locked monthly attendance</td>
                <td>X-API-Token</td>
            </tr>
            <tr>
                <td>/api/payroll/overtime-data</td>
                <td>GET</td>
