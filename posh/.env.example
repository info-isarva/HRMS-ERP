APP_NAME="POSH Compliance"
POSH_PRODUCT_NAME="POSH Compliance"
POSH_PRODUCT_SHORT_NAME="POSH"
POSH_PRODUCT_TAGLINE="Workplace Safety & Compliance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://poshdev.isarva.in

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms_poshdev
DB_USERNAME=hrms_poshdev_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Must match HRMS hub, Payroll, Attendance, CRM
JWT_SECRET=
JWT_HMAC_SECRET=

SSO_WORKSPACE_URL=https://hrmsdev.isarva.in

POSH_DEFAULT_ORG_NAME="Your Organization"
POSH_DEFAULT_ORG_KEY=default
POSH_DEFAULT_EMPLOYEE_COUNT=10
# Strip vendor prefixes from org names in UI (comma-separated)
POSH_ORG_NAME_PREFIXES_STRIP=ISARVA,Isarva,isarva

# Comma-separated hub login emails that receive HR Admin in POSH
POSH_BOOTSTRAP_ADMIN_EMAILS=

# Deployment defaults for new orgs (overridden per-org via Settings toggle)
# employee_source: payroll | posh
# auth_mode: sso | native
POSH_DEFAULT_EMPLOYEE_SOURCE=payroll
POSH_DEFAULT_AUTH_MODE=sso
